---
import Default from '@astrojs/starlight/components/Head.astro';
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&family=Ubuntu+Mono:ital,wght@0,400;0,700;1,400&display=swap"
	rel="stylesheet"
/>
<script is:inline>
	{
		const key = 'starlight-theme';
		if (!localStorage.getItem(key)) localStorage.setItem(key, 'light');
	}
</script>
<Default><slot /></Default>
